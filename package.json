{
  "name": "lumen-reader",
  "productName": "Lumen Reader",
  "version": "1.2.0",
  "description": "Beautiful desktop ebook reader: FB2, EPUB, TXT, HTML with covers, highlights and OPDS libraries",
  "main": "src/main.js",
  "author": "gobli",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "build": {
    "appId": "com.gobli.lumenreader",
    "productName": "Lumen Reader",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "LumenReader-portable-${version}.exe"
    },
    "nsis": {
      "artifactName": "LumenReader-setup-${version}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Lumen Reader"
    }
  }
}